# No credentials or external services required.
# Local mock task journal; never use a shared or public data directory.
CONJMAP_TASK_DIR=.local/tasks

# Real integration is disabled until an actual compatible MathForge API exists.
# Configure secrets through the local environment; no working credentials ship here.
# CONJMAP_MATHFORGE_URL=http://127.0.0.1:PORT/api/v2/
# CONJMAP_MATHFORGE_TOKEN=
# CONJMAP_RESEARCH_ACCESS_TOKEN=
# CONJMAP_CALLBACK_SECRET=
CONJMAP_REAL_TASK_DIR=.local/real-tasks
# Isolated synthetic benchmark route, disabled in normal use.
CONJMAP_ENABLE_BENCHMARK=0
