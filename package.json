{
  "name": "conjmap",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "npm run validate:data && npm run validate:v02 && npm run lint && npm run typecheck && npm test && npm run build",
    "validate:v02": "tsx scripts/validate-v02.ts"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/cytoscape": "^3.21.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
